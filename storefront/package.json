{
  "name": "signals-workshop-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:start": "next build && next start",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "snowtype:generate": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; snowtype generate --config snowtype.config.json'",
    "signals:publish": "python -m signals.config.publish",
    "seed:tracking-plans": "tsx scripts/seed-tracking-plans.ts"
  },
  "dependencies": {
    "@snowplow/browser-tracker": "^4.6.9",
    "@snowplow/signals-browser-plugin": "^0.2.2",
    "@snowplow/signals-node": "^0.3.0",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@snowplow/snowtype": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
