# Snowplow Console API credentials (BDP Console > API keys).
# Used server-side by Signals SDK calls and `npm run signals:publish` /
# `npm run snowtype:generate`. Never commit real values; copy this file
# to .env.local (gitignored).
SNOWPLOW_CONSOLE_API_KEY_ID=
SNOWPLOW_CONSOLE_API_KEY=
SNOWPLOW_CONSOLE_ORG_ID=

# Snowplow collector endpoint the browser tracker sends events to,
# e.g. https://collector.example.snowplowanalytics.com
NEXT_PUBLIC_SNOWPLOW_COLLECTOR_URL=

# Application ID the browser tracker sends on every event. Must match one of
# the appIds in tracking-assets/tracking-plans/source-applications/fashion_storefront.yml
# (e.g. signals-workshop-fashion-demo for the live trial org, or
# signals-workshop-fashion-demo-dev for local development).
NEXT_PUBLIC_SNOWPLOW_APP_ID=

# Signals interventions endpoint consumed by the browser plugin.
NEXT_PUBLIC_SIGNALS_INTERVENTIONS_ENDPOINT=

# Signals API base URL (Console > Signals), used server-side and by
# `npm run signals:publish`.
SIGNALS_DEPLOYED_URL=

# Shared secret the agent-facing tool endpoints (/api/agent/*) require on the
# X-Agent-Api-Key request header. Configured server-side only and mirrored in
# the CX Agent Studio OpenAPI tool's API-key auth config.
AGENT_SHARED_SECRET=

# ces-messenger deployment id (the CX Agent Studio web-widget channel
# deployment's full resource name, e.g.
# projects/<project>/locations/<location>/apps/<app>/deployments/<deployment>).
# Read client-side; the widget renders nothing if unset. See
# docs/setup-cx-agent-studio.md §6.
NEXT_PUBLIC_CES_DEPLOYMENT_ID=
