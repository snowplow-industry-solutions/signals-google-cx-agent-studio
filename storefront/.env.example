# Snowplow Console API credentials (BDP Console > Manage organization > API keys).
# Used server-side by Signals SDK calls and `npm run signals:publish` /
# `npm run snowtype:generate`. Tick every feature when creating the key (see
# docs/setup-snowplow-trial.md §2). Never commit real values; copy this file
# to .env.local (gitignored).
SNOWPLOW_CONSOLE_API_KEY_ID=
SNOWPLOW_CONSOLE_API_KEY=
SNOWPLOW_CONSOLE_ORG_ID=

# Snowplow collector endpoint the browser tracker sends events to,
# e.g. https://collector.example.snowplowanalytics.com
NEXT_PUBLIC_SNOWPLOW_COLLECTOR_URL=

# Application ID the browser tracker sends on every event. Must match one of
# the appIds in tracking-assets/tracking-plans/source-applications/fashion_storefront.yml
# (e.g. atelier-storefront for the live trial org, or
# atelier-storefront-dev for local development).
NEXT_PUBLIC_SNOWPLOW_APP_ID=

# Signals interventions endpoint consumed by the browser plugin.
NEXT_PUBLIC_SIGNALS_INTERVENTIONS_ENDPOINT=

# Signals API base URL (Console > Signals), used server-side and by
# `npm run signals:publish`.
SIGNALS_DEPLOYED_URL=

# Shared secret the agent-facing tool endpoints (/api/agent/*) require on the
# x-agent-api-key request header. Configured server-side only and mirrored in
# the CX Agent Studio OpenAPI tool's API-key auth config.
AGENT_SHARED_SECRET=

# ces-messenger deployment id (the CX Agent Studio web-widget channel
# deployment's full resource name, e.g.
# projects/<project>/locations/<location>/apps/<app>/deployments/<deployment>).
# Read client-side; the widget renders nothing if unset. See
# docs/setup-cx-agent-studio.md §6.
NEXT_PUBLIC_CES_DEPLOYMENT_ID=

# Optional. Email recorded as the owner on the tracking plan and Signals objects
# this repo publishes to your org. Defaults to demo-owner@example.com when unset
# or left empty.
# SNOWPLOW_OWNER_EMAIL=you@example.com

# Application ID the server-side agent tracking module (src/utils/agentTracking.ts)
# sends on every tool_execution event, so agent traffic (platform srv) can be
# filtered from browser traffic (platform web) in Console with one predicate.
# Optional; defaults to "${NEXT_PUBLIC_SNOWPLOW_APP_ID}-agent" when unset.
AGENT_SNOWPLOW_APP_ID=

# LLM model name recorded in the agent_context entity's model_name field on
# every server-side agent event. Optional; defaults to the model in
# terraform/terraform.tfvars.example (gemini-3.0-flash-001). Update if the
# live agent's model changes.
AGENT_MODEL_NAME=

# Whether the chat widget's message_sent/message_received tracking
# (src/components/Widget/useWidgetConversationTracking.ts) includes a capped
# (100 char) preview of the shopper's/concierge's message text on the
# message_context entity. Read client-side. Optional; defaults to enabled --
# set to "false" to omit previews entirely (length is still tracked).
NEXT_PUBLIC_WIDGET_MESSAGE_PREVIEWS_ENABLED=
