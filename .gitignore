node_modules/
.env*
!.env.example
.next/
.vercel/
.claude/worktrees/
.claude/settings.local.json

# Playwright MCP session artifacts
.playwright-mcp/

# Terraform local state — .tf config files are tracked; tfvars hold live
# resource IDs and stay local
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.bak-*
terraform/crash.log
terraform/crash.*.log

# Verification-script output: JSON reports and screenshots from
# scripts/verification/. Reports capture the console, including the CES
# token broker's chatToken, so they never belong in the repo.
scripts/verification/out/
scripts/verification/__pycache__/
